// Prisma schema — 커스텀 굿즈 쇼핑몰 (JH MAKER)
// 적용: npm run db:push && npm run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING // 접수
  AWAITING_PAYMENT // 입금대기
  CONFIRMED // 확인·제작 대기
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER // 무통장
  VIRTUAL_ACCOUNT
}

enum BannerPlacement {
  HOME_HERO // 메인 히어로 캐러셀
  HOME_PROMO // 메인 프로모션 띠
  HOME_IDEA // 홈 아이디어 카드
  HOME_GUIDE // 홈 가이드 카드
}

enum CollectionType {
  BEST // 재구매·베스트
  NEW // 신상품
  TRENDING // 요즘 많이 커스텀
  TEMPLATE // 1분컷 템플릿
  CUSTOM
}

/// 판매 방식: 커스텀(에디터) | 기성품
enum ProductSaleType {
  CUSTOM
  READYMADE
}

enum ProductDetailSectionType {
  STORY
  INFO
  GUIDE
  SIZE
  FAQ
  SHIPPING
  CAUTION
}

// ─── 회원 ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  /// 이메일 인증 완료 시각
  emailVerifiedAt DateTime?
  /// kakao | google | null
  oauthProvider String?
  oauthId       String?
  isGuest       Boolean  @default(false)
  pointsBalance Int      @default(0)
  /// 이용약관·개인정보 동의 시각
  termsAgreedAt   DateTime?
  privacyAgreedAt DateTime?
  /// 회원 탈퇴(소프트 삭제)
  deletedAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses     Address[]
  designs       Design[]
  orders        Order[]
  orderComments OrderComment[]
  reviews       ProductReview[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  couponClaims  CouponClaim[]
  pointLedgers  PointLedger[]
  returnRequests ReturnRequest[]
  inquiries     Inquiry[]

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

/// 이메일 인증 토큰
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

/// 포인트 적립·사용 이력
model PointLedger {
  id        String   @id @default(cuid())
  userId    String
  /// EARN | SPEND | ADJUST
  type      String
  amount    Int
  balance   Int
  reason    String?
  orderId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("point_ledgers")
}

/// 사이트 설정 (사업자·계좌·배송비 등) — JSON 한 줄
model SiteSetting {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// 장바구니 (기성품)
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, updatedAt])
  @@map("cart_items")
}

/// 찜
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

/// 비밀번호 재설정 토큰
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

/// 쿠폰
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  /// PERCENT | FIXED
  discountType   String    @default("FIXED")
  discountValue  Int
  minOrderAmount Int       @default(0)
  maxDiscount    Int?
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  perUserLimit   Int       @default(1)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  claims CouponClaim[]

  @@map("coupons")
}

model CouponClaim {
  id        String    @id @default(cuid())
  couponId  String
  userId    String
  usedAt    DateTime?
  orderId   String?
  createdAt DateTime  @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([couponId, userId])
  @@index([userId, createdAt])
  @@index([orderId])
  @@map("coupon_claims")
}

/// 배송지 (회원당 복수)
model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String   @default("기본") // 집, 회사 등
  recipientName String
  phone         String
  zipCode       String
  address1      String
  address2      String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("addresses")
}

// ─── 카탈로그 (마플 상품·카테고리·컬렉션) ───────────────────────────────────

/// 상품 카테고리 (에코백, 장바구니, 파우치 …)
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

/// 판매 상품
model Product {
  id           String  @id @default(cuid())
  categoryId   String?
  slug         String  @unique
  name         String
  shortDesc    String? // 목록·카드용 한 줄 설명
  description  String? // 상세 설명
  basePrice    Int // 기본 단가 (원)
  minQuantity  Int     @default(1)
  maxQuantity  Int     @default(9999)
  thumbnailUrl String?
  /// CUSTOM: 에디터 커스텀 / READYMADE: 기성품
  saleType     ProductSaleType @default(CUSTOM)
  /// 빌더 캔버스 타입: ecobag | shopping-bag | pouch (CUSTOM일 때 사용)
  builderType  String  @default("ecobag")
  /// 빌더 옵션 기본값·가격 규칙 (원단/사이즈 등)
  optionSchema Json?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false) // 베스트·추천 노출
  isNew        Boolean @default(false) // 신상품 뱃지
  /// 기성품 재고. null = 무제한(커스텀 등)
  stockQuantity Int?
  /// 상품정보제공고시 [{ label, value }]
  noticeJson   Json?
  ratingAvg    Float   @default(0)
  reviewCount  Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category           Category?              @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  mockupFaces        ProductMockupFace[]
  collectionItems    ProductCollectionItem[]
  quantityDiscounts  QuantityDiscountRule[]
  templates          DesignTemplate[]
  designs            Design[]
  orders             Order[]
  orderItems         OrderItem[]
  reviews            ProductReview[]
  detailSections     ProductDetailSection[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]

  @@index([categoryId, isActive, sortOrder])
  @@index([saleType, isActive, sortOrder])
  @@map("products")
}

/// 커스텀 빌더 면별 목업 이미지 + 인쇄영역 (비율 0~1)
model ProductMockupFace {
  id          String   @id @default(cuid())
  productId   String
  /// 내부 키 (면 전환·디자인 저장용). 표시명은 label
  side        String
  label       String   @default("면")
  imageUrl    String
  imageWidth  Int
  imageHeight Int
  printX      Float
  printY      Float
  printW      Float
  printH      Float
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, side])
  @@index([productId, sortOrder])
  @@map("product_mockup_faces")
}

/// 상품 상세 하단 콘텐츠 (스토리·가이드·FAQ 등)
model ProductDetailSection {
  id        String                   @id @default(cuid())
  productId String
  type      ProductDetailSectionType
  title     String
  body      String   @db.Text
  imageUrl  String?
  sortOrder Int                      @default(0)
  isActive  Boolean                  @default(true)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type, sortOrder])
  @@map("product_detail_sections")
}

/// 상품 이미지 갤러리
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// 홈·기획전 컬렉션 (베스트, 신상, 1분컷 …)
model ProductCollection {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  type      CollectionType @default(CUSTOM)
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  items ProductCollectionItem[]

  @@map("product_collections")
}

model ProductCollectionItem {
  id           String @id @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId, sortOrder])
  @@map("product_collection_items")
}

/// 수량별 할인 (마플 대량가)
model QuantityDiscountRule {
  id            String @id @default(cuid())
  productId     String
  minQuantity   Int
  /// 할인 후 단가 (원). null이면 discountRate 사용
  unitPrice     Int?
  discountRate  Float? // 0.18 = 18% 할인
  label         String? // "100개 이상 3,800원"
  sortOrder     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, minQuantity])
  @@map("quantity_discount_rules")
}

/// 1분컷 디자인 템플릿 (빌더 시작 상태)
model DesignTemplate {
  id           String   @id @default(cuid())
  productId    String
  title        String
  description  String?
  thumbnailUrl String?
  /// 빌더 초기 payload 일부 (옵션·샘플 텍스트 등)
  builderJson  Json?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive, sortOrder])
  @@map("design_templates")
}

/// 상품 리뷰 (마플 실시간 리뷰)
model ProductReview {
  id        String   @id @default(cuid())
  productId String
  userId    String
  orderId   String?
  rating    Int // 1~5
  title     String?
  content   String
  isVisible Boolean  @default(true)
  isHot     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, isVisible, createdAt])
  @@map("product_reviews")
}

// ─── 쇼핑몰 콘텐츠 (메인 배너) ───────────────────────────────────────────────

model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement @default(HOME_HERO)
  tag       String? // BEST, NEW, HOT
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

/// 홈 가이드·상황별 굿즈 소개글 (마플형 상세)
model ContentArticle {
  id            String   @id @default(cuid())
  /// GUIDE | IDEA | CASE
  type          String
  slug          String   @unique
  title         String
  subtitle      String?
  /// 홈 카드 커버
  coverImageUrl String?
  /// 홈 카드 태그/이모지 등
  cardTag       String?
  cardGradient  String?
  /// intro: string[]
  introJson     Json
  /// sections: { title, body[], tips?, products? }[]
  sectionsJson  Json
  /// faq: { q, a }[]
  faqJson       Json
  publishedAt   DateTime @default(now())
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type, isActive, sortOrder])
  @@map("content_articles")
}

// ─── 디자인·주문 (기존 핵심 플로우) ─────────────────────────────────────────

model Design {
  id          String   @id @default(cuid())
  userId      String
  productId   String?
  title       String   @default("무제 작업")
  /// 빌더 전체 상태 (옵션, 캔버스, 주석, 목업 오프셋 등)
  builderJson Json
  previewUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  orders  Order[]

  @@index([userId, updatedAt])
  @@map("designs")
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  productId   String
  designId    String?
  status      OrderStatus @default(PENDING)
  quantity    Int         @default(1)
  /// 금액 (원)
  subtotal    Int         @default(0)
  discountAmount Int      @default(0)
  /// 쿠폰 할인액
  couponDiscount Int      @default(0)
  /// 사용한 포인트
  pointsUsed     Int      @default(0)
  couponClaimId  String?
  shippingFee Int         @default(0)
  totalPrice  Int
  notes       String? // 고객 요청사항
  /// 배송 정보 (스냅샷 — 주문 시점 고정)
  shippingName    String?
  shippingPhone   String?
  shippingZip     String?
  shippingAddress String?
  /// 결제
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  /// 배송 추적
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  design   Design?         @relation(fields: [designId], references: [id])
  items    OrderItem[]
  comments OrderComment[]
  payments Payment[]
  reviews  ProductReview[]
  couponClaims CouponClaim[]
  returnRequests ReturnRequest[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

/// 교환·반품 신청
model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  /// EXCHANGE | RETURN
  type      String
  reason    String   @db.Text
  /// PENDING | APPROVED | REJECTED | DONE
  status    String   @default("PENDING")
  adminNote String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("return_requests")
}

/// 1:1 문의
model Inquiry {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  email      String
  subject    String
  body       String   @db.Text
  /// OPEN | ANSWERED | CLOSED
  status     String   @default("OPEN")
  adminReply String?  @db.Text
  repliedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("inquiries")
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  productName String // 주문 시점 상품명 스냅샷
  quantity    Int
  unitPrice   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

/// 주문·작업 코멘트 (고객 ↔ 관리자)
model OrderComment {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_comments")
}

/// 결제 이력 (입금 확인·환불 추적)
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  method        PaymentMethod
  status        PaymentStatus @default(UNPAID)
  amount        Int
  transactionId String? // PG 거래번호
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("payments")
}
